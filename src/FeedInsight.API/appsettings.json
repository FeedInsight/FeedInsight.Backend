{
  "OutboxProcessor": {
    "MaxRetries": 3,
    "BaseDelayMilliseconds": 5000
  },

  "ConnectionStrings": {
    "DefaultConnection": "<YOUR_CONNECTION_STRING_HERE>"
  },

  "DbScan": {
    "Epsilon": 0.5,
    "MinimumPointsPerCluster": 5
  },

  "JiraSettings": {
    "UrgencyCustomFieldId": "customfield_10023",
    "DefaultProjectKey": "SCRUM",
    "AllowedIssueTypes": ["Story"],
    "PriorityMappings": [
        { "MinUrgencyScore": 8, "PriorityId": "1" },
        { "MinUrgencyScore": 6, "PriorityId": "2" },
        { "MinUrgencyScore": 4, "PriorityId": "3" },
        { "MinUrgencyScore": 2, "PriorityId": "4" },
        { "MinUrgencyScore": 0, "PriorityId": "5" }
    ]
  },

  "SecuritySettings": {
    "EncryptionKey": "<YOUR_32_BYTE_BASE64_STRING_HERE>"
  },

  "JwtSettings": {
    "Secret": "<SUPER_SECRET_KEY_THAT_IS_AT_LEAST_32_CHARACTERS_LONG_FOR_HMAC256>",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "Issuer": "FeedInsight",
    "Audience": "FeedInsight_Frontend"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200",
      "https://feed-insight-frontend.vercel.app"
    ]
  },

  "OpenAI": {
    "ApiKey": "<YOUR_OPENAI_API_KEY>",
    "ChatModelId": "gpt-4o-mini",
    "EmbeddingModelId": "text-embedding-3-small"
  },

  "HuggingFace": {
    "ApiKey": "<YOUR_HUGGINGFACE_API_KEY>",
    "EmbeddingApiKeys": [
      "<YOUR_HUGGINGFACE_API_KEY_1>",
      "<YOUR_HUGGINGFACE_API_KEY_2>"
    ],
    "ChatModelId": "meta-llama/Llama-3.1-8B-Instruct",
    "ChatEndpoint": "https://router.huggingface.co/v1/",
    "EmbeddingModelId": "qwen3-embedding-8b",
    "EmbeddingEndpoint": "https://router.huggingface.co/scaleway/v1/"
  },

  "Qdrant": {
    "Url": "<YOUR_QDRANT_URL>",
    "ApiKey": "<YOUR_QDRANT_API_KEY>",
    "Collections": {
      "extracted_tasks": {
        "VectorSize": 4096,
        "Distance": "Cosine",
        "IndexFields": [
          "TenantId",
          "CategoryId"
        ]
      },
      "user_stories": {
        "VectorSize": 4096,
        "Distance": "Cosine",
        "IndexFields": [
          "TenantId",
          "CategoryId"
        ]
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "TriageAgent": {
    "DeduplicationSimilarityThreshold": 0.70,
    "CandidateRetrievalLimit": 5
  }
}
